NODE_ENV=production
PORT=3000
LOG_LEVEL=warn

# Auth — REQUIRED: must match auth-iam JWT_SECRET
JWT_SECRET=

# Redis — REQUIRED: production Redis URL
REDIS_URL=redis://<HOST>:6379

# Downstream services — REQUIRED: internal service URLs
AUTH_SERVICE_URL=http://auth-iam:3001
ZONE_SERVICE_URL=http://zone-policy:3002
DEVICE_SERVICE_URL=http://device-management:3003
CONTENT_SERVICE_URL=http://content-service:3004
SCHEDULE_SERVICE_URL=http://schedule-service:3005
SYNC_SERVICE_URL=http://sync-service:3006
AUDIT_SERVICE_URL=http://audit-service:3009

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
METRICS_PORT=9464
